{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --production",
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/configurator/dist/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
{ "source": "/frame-my-photo", "destination": "/frame-my-photo.html" },
    { "source": "/fine-art-printing", "destination": "/frame-my-photo.html?printType=art_paper" },
    { "source": "/success", "destination": "/success.html" }
  ]
}
